# Copy to .env.local and fill in. .env* is gitignored — never commit real values.

# ---------------------------------------------------------------------------
# Database (required for the strategy-call form to store leads)
# ---------------------------------------------------------------------------
# Works with any Postgres provider (Neon, Supabase, Railway, RDS, local).
# Hosted providers generally require SSL, e.g. append ?sslmode=require
#
# Apply the schema once before first use:
#   psql "$DATABASE_URL" -f db/schema.sql
#
# Without this, the form validates and responds but tells the visitor to email
# instead, and logs a clear error server-side. It never fakes success.
DATABASE_URL=postgres://user:password@host:5432/database

# ---------------------------------------------------------------------------
# Lead notification email (optional — leads are still stored without it)
# ---------------------------------------------------------------------------
# Transactional email via Resend (https://resend.com). Create an API key and
# verify the sending domain before going live.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Must be an address on a domain verified with your email provider.
LEADS_EMAIL_FROM="ForgeGTM Website <notifications@forgegtm.com>"

# Where lead alerts are delivered. Defaults to leads@forgegtm.com if unset.
LEADS_EMAIL_TO=leads@forgegtm.com

# Optional: override the provider endpoint. Only useful for local testing
# against a mock server. Leave unset in production.
# RESEND_API_URL=http://127.0.0.1:5599/emails
