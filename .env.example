# Copy to .env.local and fill in. .env* is gitignored — never commit real values.

# ---------------------------------------------------------------------------
# Database (required for the strategy-call form to store leads)
# ---------------------------------------------------------------------------
# Works with any Postgres provider (Neon, Supabase, Railway, RDS, local).
# Hosted providers generally require SSL, e.g. append ?sslmode=require
#
# Apply the schema once before first use:
#   psql "$DATABASE_URL" -f db/schema.sql
#
# Without this, the form validates and responds but tells the visitor to email
# instead, and logs a clear error server-side. It never fakes success.
DATABASE_URL=postgres://user:password@host:5432/database

# ---------------------------------------------------------------------------
# Lead notification email (optional — leads are still stored without it)
# ---------------------------------------------------------------------------
# Two transports are supported. SMTP is used when SMTP_USER and SMTP_PASSWORD
# are set; otherwise Resend is used if its variables are set; otherwise the
# alert is skipped (the lead is still stored either way).

# --- Option 1: Gmail SMTP — works today, no domain required ------------------
# Requires a Google App Password, NOT the account password:
#   1. Enable 2-Step Verification on the Google account.
#   2. https://myaccount.google.com/apppasswords -> create one for "Mail".
#   3. Paste the 16 characters below (spaces are fine, they are ignored).
# The App Password is a credential: keep it in .env.local, never in git.
SMTP_USER=contact.forgegtm@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx

# Optional — defaults are Gmail's. Port 465 = implicit TLS, 587 = STARTTLS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# --- Option 2: Resend — preferred once you own a domain ---------------------
# Better long-term: a sender on your own verified domain authenticates properly
# and is far less likely to be spam-foldered than Gmail-relayed mail.
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# The SENDER for Resend. Must be on a domain you have verified with Resend.
# It cannot be a Gmail address: Resend will not verify a domain you do not
# control, and gmail.com's DMARC policy tells inboxes to reject mail sent from
# it by a third party.
# LEADS_EMAIL_FROM="ForgeGTM Website <notifications@forgegtm.com>"

# --- Recipient (applies to both transports) ---------------------------------
# Where lead alerts land. Any mailbox works, Gmail included.
# Defaults to the address in lib/site.ts (contact.forgegtm@gmail.com) if unset.
LEADS_EMAIL_TO=contact.forgegtm@gmail.com

# Optional: override the provider endpoint. Only useful for local testing
# against a mock server. Leave unset in production.
# RESEND_API_URL=http://127.0.0.1:5599/emails

# ---------------------------------------------------------------------------
# Site origin (optional)
# ---------------------------------------------------------------------------
# Absolute origin used for canonical URLs, hreflang alternates, sitemap.xml,
# robots.txt and JSON-LD. Defaults to https://forgegtm.com when unset.
#
# Set it on preview/staging deployments so those builds do not advertise
# themselves under the production domain. A trailing slash is fine — it is
# stripped. Read at build time, so changing it requires a rebuild.
# NEXT_PUBLIC_SITE_URL=https://staging.forgegtm.com

# ---------------------------------------------------------------------------
# Admin dashboard (/admin)
# ---------------------------------------------------------------------------
# The dashboard lists every lead's contact details, so it is behind HTTP Basic
# auth. Without ADMIN_PASSWORD set, /admin returns 503 and is unreachable —
# it never falls open.
ADMIN_USER=forgegtm
ADMIN_PASSWORD=choose-a-long-random-password
